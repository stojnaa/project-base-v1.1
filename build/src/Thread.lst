 101:src/Thread.cpp **** void _thread::dispatch() {
 102:src/Thread.cpp ****     _thread* old = running;
 103:src/Thread.cpp **** 
 104:src/Thread.cpp ****     if (old != nullptr && old->state != FINISHED && old->state != BLOCKED) {
 105:src/Thread.cpp ****         Scheduler::put(old);
 106:src/Thread.cpp ****     }
 107:src/Thread.cpp **** 
 108:src/Thread.cpp ****     _thread* next = Scheduler::get();
 109:src/Thread.cpp **** 
 110:src/Thread.cpp ****     if (next == nullptr) {
 111:src/Thread.cpp ****         if (old != nullptr && old->state == RUNNING) {
 112:src/Thread.cpp ****             running = old;
 113:src/Thread.cpp ****         }
 114:src/Thread.cpp ****         return;
 115:src/Thread.cpp ****     }
 116:src/Thread.cpp **** 
 117:src/Thread.cpp ****     running = next;
 118:src/Thread.cpp ****     running->state = RUNNING;
 119:src/Thread.cpp **** 
 120:src/Thread.cpp ****     if (old != nullptr && old != running) {//ako je scheduler vratio istu nit ne treba contextswitc
 121:src/Thread.cpp ****         if (old->pinged) {
 122:src/Thread.cpp ****             printString("PING: thread allocated ");
 123:src/Thread.cpp ****             printInt(old->allocatedBlocks);
 124:src/Thread.cpp ****             printString(" blocks before losing context\n");
 125:src/Thread.cpp **** 
 126:src/Thread.cpp ****             old->pinged = false;
 127:src/Thread.cpp ****         }
 128:src/Thread.cpp ****         contextSwitch(&old->context, &running->context);
 129:src/Thread.cpp ****     }
 130:src/Thread.cpp **** }
