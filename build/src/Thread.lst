 105:src/Thread.cpp ****         if (old != nullptr && old->state == RUNNING) {
 106:src/Thread.cpp ****             running = old;
 107:src/Thread.cpp ****         }
 108:src/Thread.cpp ****         return;
 109:src/Thread.cpp ****     }
 110:src/Thread.cpp **** 
 111:src/Thread.cpp ****     running = next;
 112:src/Thread.cpp ****     running->state = RUNNING;
 113:src/Thread.cpp **** 
